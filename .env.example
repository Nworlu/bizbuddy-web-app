# BizBuddy accounts (Supabase). Copy to .env.local and fill in from Supabase: Project Settings -> API.
# Without these, accounts are switched off and the books stay on the phone only.
# The publishable (anon) key is safe in the browser. Never put the service_role / secret key here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# A mailbox you control. Each phone number logs in as its plus-address (owner+2348031234567@gmail.com).
# Nothing is sent while Supabase's email confirmation is off. Changing it later changes every login.
NEXT_PUBLIC_LOGIN_EMAIL=you@example.com

# Tell BizBuddy and WhatsApp. OpenAI reads the note. SERVER ONLY: no NEXT_PUBLIC_ prefix, never in the browser.
# Also add it in Vercel's environment variables.
# Confirmed notes are remembered per shop. Run supabase/migrations/0003_shop_memory.sql in the SQL editor.
OPENAI_API_KEY=sk-...
# Optional: which OpenAI model reads the notes. Default gpt-5.4-mini.
# OPENAI_MODEL=gpt-5.4-mini
# Voice notes on WhatsApp. Defaults to gpt-4o-mini-transcribe. Uses the same OPENAI_API_KEY.
# OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# WhatsApp Cloud API (Meta for Developers -> your app -> WhatsApp). SERVER ONLY.
WHATSAPP_PHONE_NUMBER_ID=...
WHATSAPP_ACCESS_TOKEN=...
# App settings -> Basic -> App secret. Proves webhook calls come from Meta.
WHATSAPP_APP_SECRET=...
# Any long random string you choose; type the same one into Meta's webhook settings.
WHATSAPP_VERIFY_TOKEN=...
# Supabase -> Project Settings -> API keys -> secret key. Lets WhatsApp record into the sender's shop.
SUPABASE_SECRET_KEY=sb_secret_...
# Public address of the app, used in replies to numbers without an account.
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# BizBuddy admin dashboard at /admin. SERVER ONLY — never expose in the browser bundle.
ADMIN_SECRET=

# Reminders for notes left waiting on Save / Cancel: a scheduler calls GET /api/whatsapp/remind every
# few minutes with Authorization: Bearer <CRON_SECRET> (Vercel Cron sends it by itself; cron-job.org works too).
CRON_SECRET=
# Minutes before the one reminder (default 30).
WHATSAPP_REMIND_AFTER_MINUTES=
# Templates for messages BizBuddy starts more than 24 hours after the owner's last message (defaults shown).
WHATSAPP_REMINDER_TEMPLATE=
WHATSAPP_CHECKIN_TEMPLATE=
WHATSAPP_WEEKLY_TEMPLATE=
